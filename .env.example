# ==============================================================================
# ClientPulse AI — Environment Variables Example (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' (for Next.js frontend) and/or use with Supabase Secrets.
# 2. Fill in your actual values.
# 3. NEVER commit '.env', '.env.local', or any real secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for frontend and Edge Functions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon Key (safe for frontend, respects Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Supabase Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND!)
# Used by Edge Functions for token-gated portal queries and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Google Gemini API
# Found in: Google AI Studio (https://aistudio.google.com/) -> Get API Key
# ------------------------------------------------------------------------------
# Secret API key used strictly inside Supabase Edge Functions for report generation
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key

# ------------------------------------------------------------------------------
# Resend (Transactional Email Service)
# Found in: Resend Dashboard (https://resend.com) -> API Keys
# ------------------------------------------------------------------------------
# Secret API key used strictly inside Supabase Edge Functions for sending emails
RESEND_API_KEY=re_your_resend_api_key

# Default sender address
# For testing on free tier without a custom domain: use 'onboarding@resend.dev'
# For production with verified domain: use 'ClientPulse <reports@yourdomain.com>'
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# Internal Security & Scheduler Secrets
# ------------------------------------------------------------------------------
# Shared secret token used by pg_cron / pg_net to securely call /dispatch-scheduled-reports
SCHEDULED_FUNCTION_SECRET=generate-a-secure-random-secret-here

# Secret 256-bit (32 bytes) base64 key used to symmetrically encrypt GitHub PATs at rest (AES-GCM)
# Generate with: openssl rand -base64 32
# Configure in Supabase Secrets: npx supabase secrets set PAT_ENCRYPTION_KEY="<32-byte-base64-key>"
# NEVER expose to frontend or log in plaintext!
PAT_ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here

# ------------------------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------------------------
# Base URL of the web application (used when generating client portal links in emails)
# Local: http://localhost:3000 | Production: https://clientpulse.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
